# Copy to .env for local development. Never commit real credentials.
DATABASE_URL=postgresql://localhost:5432/aidflow
# Optional: set true only when your database requires verified TLS and its CA is trusted.
DATABASE_SSL=false
PORT=10000
# Comma-separated exact frontend origins, e.g. https://your-aidflow-site.onrender.com
FRONTEND_ORIGINS=http://localhost:5173
PG_POOL_MAX=10
